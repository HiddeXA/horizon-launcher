<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voor aanbevelingen en posters -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Om op het instellingenscherm het adres van de tv te tonen -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Kanaalbeelden van apps lezen (zoals de Apple TV top shelf). Wordt via adb toegekend. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <!-- TV-app: geen touchscreen, leanback ondersteund -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Nodig om de lijst met geïnstalleerde apps te mogen zien (Android 11+) -->
    <queries>
        <!-- Apps waar het filmscherm naar doorlinkt -->
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="ar.tvplayer.tv" />
        <package android:name="org.xbmc.kodi" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".data.ThuisApp"
        android:label="@string/app_name"
        android:icon="@drawable/banner"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Thuis"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: veel IPTV-aanbieders gebruiken http:// in plaats van https:// -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">

            <!-- Zichtbaar in de app-lijst (zodat je kunt testen vóór het debloaten) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Dit maakt de app een homescherm -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Horizon (voorheen Bios): je filmaanbod als streamingapp, met een eigen tegel -->
        <activity
            android:name=".bios.BiosActivity"
            android:exported="true"
            android:label="Horizon"
            android:icon="@drawable/horizon_banner"
            android:banner="@drawable/horizon_banner"
            android:theme="@style/Theme.Horizon"
            android:launchMode="singleTask"
            android:taskAffinity="nl.thuis.bios"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Horizon TV: live-tv met tv-gids, eigen tegel, zelfde huisstijl -->
        <activity
            android:name=".tv.TvActivity"
            android:exported="true"
            android:label="Horizon TV"
            android:icon="@drawable/horizon_tv_banner"
            android:banner="@drawable/horizon_tv_banner"
            android:theme="@style/Theme.Horizon"
            android:launchMode="singleTask"
            android:taskAffinity="nl.thuis.horizontv"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Roze Hoek: alleen de 18+-zenders. Standaard UIT (geen tegel); aan te zetten in Instellingen. -->
        <activity
            android:name=".tv.RozeHoekActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Roze Hoek - Inspired By Eppie Bos"
            android:icon="@drawable/roze_hoek_banner"
            android:banner="@drawable/roze_hoek_banner"
            android:theme="@style/Theme.Horizon"
            android:launchMode="singleTask"
            android:taskAffinity="nl.thuis.rozehoek"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".bios.PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.Thuis"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode" />
    </application>
</manifest>
