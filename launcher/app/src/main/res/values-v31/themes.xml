<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: het systeem-opstartscherm leeg en inktblauw, onze eigen animatie neemt het over -->
    <style name="Theme.Horizon" parent="Theme.Thuis">
        <item name="android:windowBackground">#0B132B</item>
        <item name="android:windowSplashScreenBackground">#0B132B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_leeg</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <style name="Theme.RozeHoek" parent="Theme.Horizon">
        <item name="android:windowBackground">#1E0A1E</item>
        <item name="android:windowSplashScreenBackground">#1E0A1E</item>
    </style>
</resources>
